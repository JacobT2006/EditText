{
  "name": "EditText",
  "version": "0.1.1",
  "productName": "EditText",
  "description": "A desktop notes app that saves for you",
  "repository": {
    "type": "git",
    "url": "https://github.com/JacobT2006/EditText"
  },
  "license": "MIT",
  "author": "JacobT2006",
  "type": "commonjs",
  "main": "main.js",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "start": "electron .",
    "start:prod": "cross-env NODE_ENV=production electron .",
    "build:prod": "cross-env NODE_ENV=production electron-builder build --mac --win --linux",
    "build:mac": "cross-env NODE_ENV=production electron-builder build --mac",
    "build:win": "cross-env NODE_ENV=production electron-builder build --win --x64",
    "build:linux": "cross-env NODE_ENV=production electron-builder build --linux",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jacobt2006.edittext",
    "productName": "EditText",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styleIndex.css",
      "Assets/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "icon": "Assets/AppIcon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "Assets/AppIcon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "Assets/AppIcon-512.png",
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "dependencies": {
    "update-electron-app": "^3.3.0"
  }
}
